{
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useExhaustiveDependencies": "off",
        "useUniqueElementIds": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules/",
      "!**/dist/",
      "!**/public/",
      "!**/coverage/"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git"
  }
}